# Example environment variables for GraphMind
APP_ENV=development
PORT=8000
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=graphmind
TIGERGRAPH_USER=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
# TIGERGRAPH_SECRET=  # Optional: use secret key instead of password
DATABASE_URL=sqlite:///./.graphmind/graph.db

# LLM provider: GitHub Models (uses `gh auth token` automatically)
# No GITHUB_TOKEN needed if `gh` is authenticated. Otherwise:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# HuggingFace removed in v2 — GitHub Models is the sole LLM provider