// TigerGraph schema for CodeGraphX
// Vertices: Module, Class, Function, Import
// Edges: defines, calls, inherits, imports, contains, depends_on

CREATE VERTEX Module (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
CREATE VERTEX Class (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
CREATE VERTEX Function (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
CREATE VERTEX Import (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";

CREATE UNDIRECTED EDGE defines (FROM Module, TO Function) WITH REVERSE_EDGE="true";
CREATE UNDIRECTED EDGE contains (FROM Module, TO Class) WITH REVERSE_EDGE="true";
CREATE DIRECTED EDGE calls (FROM Function, TO Function);
CREATE DIRECTED EDGE inherits (FROM Class, TO Class);
CREATE DIRECTED EDGE imports (FROM Module, TO Import);
CREATE DIRECTED EDGE depends_on (FROM Function, TO Class);

// Note: No complex queries or load jobs defined here per plan
